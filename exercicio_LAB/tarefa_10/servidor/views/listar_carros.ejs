<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Listar Carros</title>
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background-color: #f4f6f9;
      margin: 0;
      padding: 40px;
      color: #333;
    }

    h1 {
      text-align: center;
      color: #2c3e50;
      margin-bottom: 30px;
    }

    .carro {
      background-color: #fff;
      border: 1px solid #ddd;
      border-radius: 10px;
      padding: 20px;
      margin: 20px auto;
      width: 80%;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: transform 0.2s ease;
    }

    .carro h2 {
      color: #34495e;
      margin-bottom: 10px;
    }

    .carro p {
      margin: 5px 0;
      font-size: 15px;
    }

    a {
      display: inline-block;
      margin-top: 20px;
      text-decoration: none;
      background-color: #27ae60;
      color: white;
      padding: 10px 18px;
      border-radius: 6px;
      font-weight: bold;
      transition: background-color 0.3s ease;
    }

    a:hover {
      background-color: #219150;
    }
  </style>
</head>
<body>
  <h1>Carros Disponíveis</h1>
  <% lista_carros.forEach(function(carro) { %>
    <div class="carro">
      <h2><%= carro.modelo %></h2>
      <p>Marca: <%= carro.marca %></p>
      <p>
  Quantidade:
  <% if (carro.quantidade === 0) { %>
    <strong style="color:red;">Esgotado</strong>
  <% } else { %>
    <%= carro.quantidade %>
  <% } %>
</p>

    </div>
  <% }); %>
  <div style="text-align:center;">
  <a href="/gerenciar">Gerenciar Carros</a>
  </div>
</body>
</html>
